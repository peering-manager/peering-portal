# Peering Portal configuration.

# Peering Manager URL (no trailing slash)
PM_URL=https://peering.example.com

# Peering Manager API token
PM_TOKEN=your-api-token-here

# Secret used to sign the wizard's session cookie. When unset, a random key is
# generated at startup and in-flight wizard sessions reset on every restart. Set
# a stable value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`,
# when running several replicas or restarting often.
#SECRET_KEY=

HOST=0.0.0.0
PORT=8080

# Set to 1 to enable uvicorn auto-reload (dev only)
RELOAD=
