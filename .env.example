# Peering Portal configuration.

# Peering Manager URL (no trailing slash)
PM_URL=https://peering.example.com

# Peering Manager API token
PM_TOKEN=your-api-token-here

# Secret used to sign the session cookie, which carries the wizard state and the PeeringDB sign-in.
# When unset, a random key is generated at startup and every visitor is signed out on restart. Set
# a stable value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`, when running
# several replicas or restarting often.
#SECRET_KEY=

# Set to 1 when the portal is served over HTTPS, to mark the session cookie as secure
#SESSION_COOKIE_SECURE=

# PeeringDB OAuth. Without these two values the portal accepts any ASN from any visitor, which lets
# anybody request peering in the name of a network they do not own. Register an application on
# https://www.peeringdb.com/oauth2/applications/ as a confidential client using the authorization
# code grant, with the redirect URI below.
#PDB_CLIENT_ID=
#PDB_CLIENT_SECRET=

# Public URL of the callback route. It must match the redirect URI registered on PeeringDB exactly.
# When unset, the portal builds it from the incoming request, which is wrong behind a reverse proxy.
#PDB_REDIRECT_URI=https://your-portal.example.com/auth/callback

# Rights a network must grant the user on PeeringDB before the portal accepts a request for it.
# PeeringDB grants 1 read, 2 update, 4 create and 8 delete, added together. 0 accepts any
# affiliation, 2 keeps out the members who can only read the network.
#PDB_REQUIRED_PERMS=0

# PeeringDB endpoints. Only set these when PeeringDB moves them.
#PDB_AUTHORIZE_URL=https://auth.peeringdb.com/oauth2/authorize/
#PDB_TOKEN_URL=https://auth.peeringdb.com/oauth2/token/
#PDB_USERINFO_URL=https://auth.peeringdb.com/profile/v1

HOST=0.0.0.0
PORT=8080

# Set to 1 to enable uvicorn auto-reload (dev only)
RELOAD=
